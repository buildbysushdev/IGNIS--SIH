# ==============================================================================
# IGNIS Backend Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and replace placeholder values with your actual config.
# NEVER commit the real .env file or production API keys to source control.

# [REQUIRED / SENSITIVE] NASA FIRMS MAP Key
# Obtain a free key from: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Example placeholder: 0123456789abcdef0123456789abcdef
FIRMS_MAP_KEY=YOUR_NASA_FIRMS_MAP_KEY_HERE

# [OPTIONAL] Overpass API endpoint for OpenStreetMap industrial queries
OVERPASS_URL=https://overpass-api.de/api/interpreter

# [OPTIONAL] Database file path (SQLite)
DATABASE_PATH=ignis.db

# [OPTIONAL] Cache directory for JSON / model checkpoints
CACHE_DIR=cache

# [OPTIONAL] Service Host and Port
HOST=0.0.0.0
PORT=8000

# [OPTIONAL] Allowed CORS Origins (comma-separated list in production)
# Example: https://frontend-nine-lime-27.vercel.app,http://localhost:3000
CORS_ORIGINS=https://frontend-nine-lime-27.vercel.app,http://localhost:3000
