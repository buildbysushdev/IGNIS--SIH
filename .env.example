# ==============================================================================
# PROJECT IGNIS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Live NASA FIRMS API, OSM Overpass, Open-Meteo, and Gemini AGNI-AI config

# NASA FIRMS API Credentials (Backend Only)
FIRMS_MAP_KEY=YOUR_NASA_FIRMS_MAP_KEY_HERE
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv
INDIA_BBOX=68.7,8.4,97.25,35.5

# Google Gemini API Key for AGNI-AI Incident Assistant (Backend Only)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.6-flash

# External APIs
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_URL=https://overpass-api.de/api/interpreter
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Backend Server & SQLite
PORT=8000
DATABASE_PATH=ignis.db
CACHE_DIR=cache
CORS_ORIGINS=*

# Frontend API Target (Next.js)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
