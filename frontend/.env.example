# ==============================================================================
# IGNIS Frontend Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env.local for local Next.js development.
# In production (e.g. Vercel), set this in the project Environment Variables dashboard.

# [REQUIRED / PUBLIC] Base URL for the IGNIS backend FastAPI service
# Local development: http://localhost:8000
NEXT_PUBLIC_API_URL=https://web-production-b1e6a.up.railway.app
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# [OPTIONAL / RECOMMENDED] Google Gemini API Key for direct edge/serverless AGNI-AI fallback
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
